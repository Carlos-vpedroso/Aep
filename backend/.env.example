# =========================
# Banco de Dados
# =========================
MYSQL_PUBLIC_URL=        # URL de conexão do MySQL (ex: mysql://user:pass@host:port/dbname)

# =========================
# URL do site
# =========================
URL_SITE=                # URL pública do seu site (ex: https://aepssp.com)

# =========================
# Configuração SMTP (opcional, caso queira usar SMTP)
# =========================
SMTP_HOST=               # Host SMTP (ex: smtp.mailgun.org)
SMTP_PORT=               # Porta SMTP (ex: 587)
SMTP_USER=               # Usuário SMTP (ex: postmaster@mail.aepssp.com)
SMTP_PASS=               # Senha ou API Key do SMTP

# =========================
# Mailgun (envio de emails via API recomendado)
# =========================
MAILGUN_API_KEY=         # Chave privada do Mailgun (Private API Key)
MAILGUN_DOMAIN=          # Domínio verificado no Mailgun (ex: mail.aepssp.com)
MAILGUN_FROM=            # Remetente padrão dos emails (ex: "A.E.P. <no-reply@mail.aepssp.com>")

# =========================
# Autenticação JWT
# =========================
JWT_SECRET=              # Chave secreta para assinar tokens JWT
ADMIN_KEY=               # Chave de administrador para rotas protegidas (opcional)

# =========================
# Sicoob (Pagamentos / Pix)
# =========================
SICOOB_CLIENT_ID=        # Client ID fornecido pelo Sicoob
SICOOB_CLIENT_SECRET=    # Client Secret fornecido pelo Sicoob
SICOOB_CERT_PATH=        # Caminho para o certificado .p12 ou .pem
SICOOB_CERT_PASSWORD=    # Senha do certificado

# =========================
# Redis e Socket
# =========================
REDIS_URL=               # URL do Redis (ex: redis://:password@host:port)
SOCKET_URL=              # URL do servidor WebSocket (ex: wss://exemplo.com)
