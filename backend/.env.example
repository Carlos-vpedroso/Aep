# Configuração do banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=aep
DB_DIALECT=mysql

# Porta da API
PORT=5556

# Configuração do SMTP (envio de e-mails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password_or_app_password

# Chave secreta para JWT (use uma string segura e aleatória)
JWT_SECRET=your_jwt_secret_here
ADMIN_KEY=your_admin_jwt_secret_here

SICOOB_CLIENT_ID=seu-client-id 
SICOOB_CLIENT_SECRET=seu-client-secret
SICOOB_CERT_PATH=./certificados/sicoob-certificado.pfx
SICOOB_CERT_PASSWORD=sua-senha-do-certificado

REDIS_URL=seu_redis_url